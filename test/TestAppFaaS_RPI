#!/usr/bin/env python3
import socket
import ssl
import json
import base64
from picamera2 import Picamera2
import time

HOST = "bit_test.bitone.in"
PORT = 443                      # HTTPS
FUNCTION_NAME = "SmartSort"


def capture_image():
    """Captures an image using PiCamera2 and returns bytes (JPEG)."""
    cam = Picamera2()
    cam.start()
    time.sleep(1)  # allow sensor to warm up

    frame = cam.capture_array()
    cam.stop()

    # Encode as JPEG using built‑in JPEG encoder
    from PIL import Image
    from io import BytesIO

    buf = BytesIO()
    Image.fromarray(frame).save(buf, format="JPEG")
    return buf.getvalue()


def send_image_to_faas(image_bytes):
    """Sends base64 JPEG to SmartSort FAAS via raw HTTPS socket."""
    # Base64 encode the image
    payload = {
        "image_b64": base64.b64encode(image_bytes).decode("utf-8")
    }
    body = json.dumps(payload)

    # Build HTTP request
    request = (
        f"POST /function/{FUNCTION_NAME} HTTP/1.1\r\n"
        f"Host: {HOST}\r\n"
        "Content-Type: application/json\r\n"
        f"Content-Length: {len(body)}\r\n"
        "Connection: close\r\n"
        "\r\n"
        f"{body}"
    )

    print("Connecting to SmartSort via HTTPS...")

    # Create socket
    sock = socket.create_connection((HOST, PORT))

    # Create SSL context (skip certificate verification for testing ONLY)
    context = ssl._create_unverified_context()
    ssock = context.wrap_socket(sock, server_hostname=HOST)

    # Send request
    ssock.sendall(request.encode())

    # Receive response
    response = b""
    while True:
        data = ssock.recv(4096)
        if not data:
            break
        response += data

    ssock.close()

    # Split headers and body
    response_text = response.decode(errors="ignore")
    _, body = response_text.split("\r\n\r\n", 1)

    print("\n✅ SmartSort Response:")
    print(body)


def main():
    print("📸 Capturing image from Raspberry Pi Camera...")
    img_bytes = capture_image()

    print("📡 Sending to SmartSort FAAS...")
    send_image_to_faas(img_bytes)


if __name__ == "__main__":
    main()
